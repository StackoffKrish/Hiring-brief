# Inside Intel — environment variables
# Copy this file to .env.local and fill in your own keys:
#   cp .env.example .env.local
#
# Never commit .env.local or paste real keys into source code.
# Restart the dev server after changing this file.

# --- TinyFish (Search + Fetch) ---
# Get a key at: https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Optional overrides (leave as-is unless TinyFish changes endpoints
# or you are pointing at a local mock/proxy in development).
TINYFISH_SEARCH_BASE_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_BASE_URL=https://api.fetch.tinyfish.ai

# --- gemini (AI summary) ---
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for the summary. Change this if your key/project
# does not have access to the default model.
GEMINI_MODEL=gemini-3.8-flash

# Optional override (normally not needed).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
