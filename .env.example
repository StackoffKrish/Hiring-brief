# Inside Intel — environment variables
# Copy this file to .env.local and fill in your own keys:
#   cp .env.example .env.local
#
# Never commit .env.local or paste real keys into source code.
# Restart the dev server after changing this file.

# --- TinyFish (Search + Fetch) ---
# Get a key at: https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Optional overrides (leave as-is unless TinyFish changes endpoints
# or you are pointing at a local mock/proxy in development).
TINYFISH_SEARCH_BASE_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_BASE_URL=https://api.fetch.tinyfish.ai

# --- gemini (AI summary) ---
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fast model used for summarisation. Avoid slower high-thinking
# models for this step; they can time out on fetched page content.
# Change this only if your key/project lacks access to Flash-Lite.
GEMINI_MODEL=gemini-3.5-flash-lite
# Used automatically with a compact prompt if the primary model is
# slow, rate-limited, or temporarily unavailable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional: minimal | low | medium | high. By default the app uses
# minimal for Flash-Lite and low for other Gemini 3/4 models.
# GEMINI_THINKING_LEVEL=low

# Optional override (normally not needed).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
